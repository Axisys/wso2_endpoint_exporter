          "editorMode": "code",
          "expr": "max by (endpoint) (wso2_endpoint_suspended{endpoint=~\"$endpoint\"})",
          "instant": false,
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Suspension timeline",
      "type": "timeseries"
    },
