          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (endpoint) (increase(wso2_endpoint_suspension_events_total{endpoint=~\"$endpoint\"}[1h]))",
          "instant": false,
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Suspension events per hour",
      "type": "timeseries"
    },
    {
