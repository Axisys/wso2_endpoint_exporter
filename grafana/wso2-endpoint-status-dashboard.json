      "targets": [
        {
          "editorMode": "code",
          "expr": "wso2_endpoint_suspended{endpoint=~\"$endpoint\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Endpoint status",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
